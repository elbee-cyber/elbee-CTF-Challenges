#!/bin/sh

mount -t devtmpfs none /dev

mkdir /proc
mkdir /sys
mount -t proc none /proc
mount -t sysfs none /sys

insmod /ringbus.ko
chmod 666 /dev/ringbus

# Ensure good permissions on fs
chown root:root /
chmod 755 /
for dir in /bin /sbin /lib /lib64 /etc /usr /mnt /tmp; do
    mkdir -p "$dir"
    chown root:root "$dir"
    chmod 755 "$dir"
done
find /bin /sbin /usr/bin /usr/sbin -type f -exec chown root:root {} +
chown root:root /init
chmod 744 /init
chmod 777 /tmp


chmod 600 /flag
chown root:root /flag

mkdir /mnt/hostshare && mount -t 9p -o trans=virtio hostshare /mnt/hostshare
exec su -l root
